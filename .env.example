# --- LLM: openai | anthropic | mock (mock = no key needed, shows retrieved excerpts) ---
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings: fastembed (local, free) | openai ---
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=

# --- Vector store: faiss | pgvector ---
VECTOR_STORE=faiss
PGVECTOR_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docmind

# --- Tuning ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
